---
import { Image } from 'astro:assets';
import logo from '../assets/seamless-logo.png';

// Sticky header. Nav structure is APPROVED (Master Spec §3):
// Services · What We Install · Where We Work · Projects · How We Work ·
// About · [Start a Project], phone in header, Request Service utility link.
// Phone number is open item #17 (VERIFY) — the tel: link activates only
// once the number is confirmed.
const nav = [
  { label: 'Services', href: '/services' },
  { label: 'What we install', href: '/what-we-install' },
  { label: 'Where we work', href: '/where-we-work' },
  { label: 'Projects', href: '/projects' },
  { label: 'How we work', href: '/how-we-work' },
  { label: 'About', href: '/about' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="utility">
    <div class="container utility-inner">
      <a href="/request-service">Request service</a>
      <span class="phone-slot" aria-label="Phone number pending confirmation"
        >⟦VERIFY: phone⟧</span
      >
    </div>
  </div>
  <div class="main-bar">
    <div class="container main-bar-inner">
      <a class="brand" href="/">
        <Image
          src={logo}
          alt="Seamless Point of Care"
          width={380}
          densities={[1, 2]}
          loading="eager"
        />
      </a>
      <nav class="site-nav" aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={
                    currentPath.startsWith(item.href) ? 'page' : undefined
                  }
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="btn btn-primary header-cta" href="/start-a-project">Start a project</a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-toggle-label">Menu</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="container">
      <div class="mobile-menu-top">
        <a class="btn btn-primary" href="/start-a-project">Start a project</a>
        <span class="phone-slot">⟦VERIFY: phone⟧</span>
      </div>
      <nav aria-label="Mobile">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href="/request-service">Request service</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-block-end: 1px solid var(--color-rule);
  }

  .utility {
    border-block-end: 1px solid var(--color-rule);
    background: var(--color-paper-2);
  }

  .utility-inner {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding-block: 0.375rem;
    font-size: var(--text-xs);
  }

  .utility-inner a {
    text-decoration: none;
  }

  .utility-inner a:hover {
    text-decoration: underline;
  }

  .phone-slot {
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
  }

  .main-bar-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* 0.8125rem + 46px logo keeps the bar at its previous 72px height */
    padding-block: 0.8125rem;
  }

  .brand {
    display: flex;
    align-items: center;
    margin-inline-end: auto;
  }

  .brand img {
    height: 2.875rem;
    width: auto;
  }

  @media (max-width: 900px) {
    .brand img {
      height: 2.4375rem;
    }
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .site-nav a {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-ink);
    padding-block: 0.25rem;
    border-block-end: 2px solid transparent;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--color-primary);
    border-block-end-color: var(--color-accent);
  }

  .menu-toggle {
    display: none;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    background: none;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius);
    color: var(--color-primary);
    padding: 0.5rem 0.875rem;
    cursor: pointer;
  }

  .mobile-menu {
    border-block-start: 1px solid var(--color-rule);
    background: var(--color-paper);
    padding-block: var(--space-3);
  }

  .mobile-menu-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--color-rule);
    margin-block-end: var(--space-2);
  }

  .mobile-menu nav ul {
    list-style: none;
    padding: 0;
  }

  .mobile-menu nav a {
    display: block;
    padding-block: 0.75rem;
    font-size: var(--text-lg);
    text-decoration: none;
    border-block-end: 1px solid var(--color-rule);
  }

  @media (max-width: 900px) {
    .site-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: inline-block;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const label = toggle?.querySelector('.menu-toggle-label');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    if (label) label.textContent = open ? 'Menu' : 'Close';
  });
</script>
