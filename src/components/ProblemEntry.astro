---
// Customer-voice statement rendered as a link — never typeset as quoted
// testimony (no quote marks, no attribution). Content rules §4.
interface Props {
  statement: string;
  href: string;
}

const { statement, href } = Astro.props;
---

<a class="problem-entry" href={href}>
  <span class="problem-statement">{statement}</span>
  <span class="problem-arrow" aria-hidden="true">→</span>
</a>

<style>
  .problem-entry {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-block-end: 1px solid var(--color-rule);
    text-decoration: none;
    color: var(--color-ink);
    font-size: var(--text-lg);
    font-weight: 550;
  }

  .problem-entry:first-of-type {
    border-block-start: 1px solid var(--color-rule);
  }

  .problem-arrow {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .problem-entry:hover .problem-statement {
    color: var(--color-primary);
  }
</style>
