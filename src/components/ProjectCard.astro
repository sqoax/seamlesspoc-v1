---
import PhotoPlaceholder from './PhotoPlaceholder.astro';

// Project card led by one number. Renders real data only from a verified +
// permitted content entry; until those exist, callers pass placeholder=true
// and the card shows clearly labeled pending states instead of invented
// systems or numbers.
interface Props {
  placeholder?: boolean;
  title?: string;
  system?: string;
  number?: string;
  href?: string;
  shot?: string;
}

const {
  placeholder = false,
  title,
  system,
  number,
  href = '/projects',
  shot = 'install photo from this project',
} = Astro.props;
---

<a class="project-card card" href={href}>
  <PhotoPlaceholder shot={shot} ratio="4x3" />
  <div class="project-card-body">
    {
      placeholder ? (
        <>
          <p class="project-number num">⟦VERIFY: number⟧</p>
          <h3>⟦VERIFY: case study pending verification + permission⟧</h3>
          <p class="text-secondary">Health system name renders only with written permission.</p>
        </>
      ) : (
        <>
          <p class="project-number num">{number}</p>
          <h3>{title}</h3>
          <p class="text-secondary">{system}</p>
        </>
      )
    }
  </div>
</a>

<style>
  .project-card {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
    overflow: hidden;
  }

  .project-card-body {
    padding: var(--space-2);
  }

  .project-number {
    font-size: var(--text-lg);
    color: var(--color-accent-dk);
    margin-block-end: 0.25rem;
  }

  .project-card h3 {
    font-size: var(--text-base);
    margin-block-end: 0.25rem;
  }

  .project-card p.text-secondary {
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .project-card:hover {
    border-color: var(--color-primary);
  }
</style>
