---
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  title: string;
  outcome: string;
  href: string;
  shot: string;
}

const { title, outcome, href, shot } = Astro.props;
---

<a class="install-card card" href={href}>
  <PhotoPlaceholder shot={shot} ratio="4x3" />
  <div class="install-card-body">
    <h3>{title}</h3>
    <p class="text-secondary">{outcome}</p>
  </div>
</a>

<style>
  .install-card {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
    overflow: hidden;
  }

  .install-card-body {
    padding: var(--space-2);
  }

  .install-card h3 {
    font-size: var(--text-base);
    margin-block-end: 0.25rem;
  }

  .install-card p {
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .install-card:hover {
    border-color: var(--color-primary);
  }

  .install-card:hover h3 {
    color: var(--color-primary);
  }
</style>
