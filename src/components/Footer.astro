---
// Footer per page-templates §1. Contact details (address, phone, email) are
// open item #17 (VERIFY); manufacturer logos require verified authorizations
// (open item #5) and are omitted until then.
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Services',
    links: [
      { label: 'Solution finding & procurement', href: '/services' },
      { label: 'Installation & deployment', href: '/services' },
      { label: 'Cable management', href: '/services' },
      { label: 'Service & maintenance', href: '/services' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'What we install', href: '/what-we-install' },
      { label: 'Where we work', href: '/where-we-work' },
      { label: 'Projects', href: '/projects' },
      { label: 'How we work', href: '/how-we-work' },
      { label: 'About', href: '/about' },
    ],
  },
  {
    heading: 'Get in touch',
    links: [
      { label: 'Start a project', href: '/start-a-project' },
      { label: 'Request service', href: '/request-service' },
      { label: 'Contact', href: '/contact' },
      { label: 'Capabilities overview (PDF)', href: '/seamless-capabilities.pdf' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">Seamless Point of Care</p>
        <p class="footer-descriptor">Clinical technology installation &amp; mounting</p>
        <address class="footer-contact">
          Tucker, Georgia<br />
          ⟦VERIFY: street address⟧<br />
          ⟦VERIFY: phone⟧<br />
          ⟦VERIFY: email⟧
        </address>
      </div>
      {
        columns.map((col) => (
          <nav class="footer-col" aria-label={col.heading}>
            <p class="footer-heading">{col.heading}</p>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="footer-legal">
      <p>Seamless Point of Care — an IRG of Georgia company.</p>
      <p>© {year} IRG of Georgia. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: var(--color-paper);
    padding-block: var(--space-5) var(--space-3);
    font-size: var(--text-sm);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--color-navy-2);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer-name {
    font-weight: 650;
    font-size: var(--text-base);
  }

  .footer-descriptor {
    color: var(--color-rule);
    margin-block-end: var(--space-2);
  }

  .footer-contact {
    font-style: normal;
    color: var(--color-rule);
    line-height: 1.7;
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-rule);
    margin-block-end: var(--space-1);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
  }

  .footer-col li {
    margin-block-end: 0.5rem;
  }

  .footer-col a,
  .footer-legal a {
    color: var(--color-paper);
    text-decoration: none;
  }

  .footer-col a:hover {
    text-decoration: underline;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block-start: var(--space-3);
    color: var(--color-rule);
  }
</style>
