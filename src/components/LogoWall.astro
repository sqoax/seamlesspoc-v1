---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Verified logo wall (design-tokens §6, page-templates §2.7): static grid,
// white cells, grayscale at uniform OPTICAL size, grouped by state. The
// hard gate: entries render only with verified === true AND
// permission === true explicitly. Never bypass it "temporarily."
//
// Optical sizing: marks are bucketed by aspect ratio so wide lockups and
// stacked marks read with equal presence — wide marks get less height,
// stacked marks more.

const customers = (await getCollection('customers')).filter(
  (c) => c.data.verified === true && c.data.permission === true
);

const byState = new Map<string, typeof customers>();
for (const c of customers.sort((a, b) => a.data.name.localeCompare(b.data.name))) {
  const list = byState.get(c.data.state) ?? [];
  list.push(c);
  byState.set(c.data.state, list);
}
const states = [...byState.keys()].sort();

const tier = (logo?: { width: number; height: number }): string => {
  if (!logo) return 'tier-std';
  const ratio = logo.width / logo.height;
  if (ratio > 3.2) return 'tier-wide';
  if (ratio >= 1.5) return 'tier-std';
  return 'tier-tall';
};
---

{
  customers.length > 0 ? (
    <div class="logo-wall-groups">
      {states.map((state) => (
        <div class="logo-state-group">
          <h3 class="logo-state kicker">{state}</h3>
          <ul class="logo-grid">
            {byState.get(state)!.map((c) => (
              <li class={`logo-cell card ${tier(c.data.logo)}`}>
                {c.data.logo ? (
                  <Image
                    src={c.data.logo}
                    alt={c.data.name}
                    width={320}
                    densities={[1, 2]}
                  />
                ) : (
                  <span class="logo-name">{c.data.name}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ) : (
    <div class="logo-wall-pending card">
      <p class="text-secondary">
        Customer names and logos render here only with verification and
        written permission (open item #4). Nothing appears in this grid until
        both are recorded.
      </p>
    </div>
  )
}

<style>
  .logo-state-group {
    margin-block-end: var(--space-4);
  }

  .logo-state-group:last-child {
    margin-block-end: 0;
  }

  .logo-state {
    color: var(--color-ink-2);
    margin-block-end: var(--space-2);
  }

  .logo-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .logo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .logo-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
    }
  }

  .logo-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6.5rem;
    padding: var(--space-2) var(--space-3);
  }

  .logo-cell img {
    width: auto;
    filter: grayscale(1);
    opacity: 0.75;
  }

  .logo-cell:hover img,
  .logo-cell:focus-within img {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-cell img {
      transition: filter 150ms ease-out, opacity 150ms ease-out;
    }
  }

  /* Optical size tiers by mark shape */
  .tier-wide img { height: 2.125rem; }
  .tier-std img { height: 2.75rem; }
  .tier-tall img { height: 3.5rem; }

  .logo-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-2);
    text-align: center;
  }

  /* Pending state */
  .logo-wall-pending {
    padding: var(--space-4);
    border-style: dashed;
    text-align: center;
  }

  .logo-wall-pending p {
    margin-inline: auto;
    font-size: var(--text-sm);
    max-width: 48ch;
  }
</style>
