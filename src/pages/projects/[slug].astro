---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CTABand from '../../components/CTABand.astro';

// Case-study template — page-templates §5: one screen of text, 60-second
// read. Hero photo → one-line summary with the key number → four-cell fact
// strip → short narrative (≤ 180 words) → photos → verified customer quote
// → CTA. Routes are generated ONLY for entries with verified === true and
// permission === true — an unverified draft produces no page at all.

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(
    (p) => p.data.verified === true && p.data.permission === true
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const [hero, ...gallery] = data.images;

const facts = [
  { label: 'Health system', value: data.system },
  { label: 'Scope', value: data.scope },
  { label: 'Constraints', value: data.constraints },
  { label: 'Timeline', value: data.timeline },
];
---

<Base
  title={`${data.title} — ${data.system} | Seamless Point of Care`}
  description={`${data.scope_number} — ${data.scope}. An installation project for ${data.system}.`}
>
  <article>
    <!-- Hero photo -->
    <section class="case-hero">
      <div class="container">
        {
          hero ? (
            <Image
              src={hero.src}
              alt={hero.alt}
              width={1600}
              class="case-hero-photo"
              loading="eager"
            />
          ) : (
            <div class="photo-placeholder ratio-3x2">
              <p>PHOTO-PLACEHOLDER: case-study hero, {data.title}</p>
            </div>
          )
        }
      </div>
    </section>

    <!-- Summary + fact strip -->
    <section class="case-summary">
      <div class="container">
        <span class="kicker">{data.system}</span>
        <h1>
          <span class="case-number num">{data.scope_number}.</span>
          {data.title}
        </h1>
        <dl class="fact-strip">
          {
            facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Narrative -->
    <section class="case-narrative">
      <div class="container">
        <div class="narrative-body">
          <Content />
        </div>
      </div>
    </section>

    <!-- Gallery -->
    {
      gallery.length > 0 && (
        <section class="case-gallery">
          <div class="container">
            <div class="gallery-grid">
              {gallery.map((img) => (
                <Image src={img.src} alt={img.alt} width={800} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Verified customer quote -->
    {
      data.quote && (
        <section class="case-quote">
          <div class="container">
            <figure>
              <blockquote>
                <p>“{data.quote}”</p>
              </blockquote>
              {data.quote_attribution && (
                <figcaption class="text-secondary">
                  — {data.quote_attribution}
                </figcaption>
              )}
            </figure>
          </div>
        </section>
      )
    }

    <!-- Back link -->
    <section class="case-back">
      <div class="container">
        <a href="/projects">← All projects</a>
      </div>
    </section>
  </article>

  <CTABand />
</Base>

<style>
  .case-hero {
    padding-block-start: var(--space-4);
  }

  .case-hero-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .case-summary {
    padding-block: var(--space-4);
  }

  .case-summary h1 {
    max-width: 28ch;
    margin-block-end: var(--space-4);
  }

  .case-number {
    color: var(--color-accent-dk);
  }

  .fact-strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-rule);
  }

  @media (min-width: 640px) {
    .fact-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .fact-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .fact dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    margin-block-end: 0.25rem;
  }

  .fact dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .case-narrative {
    padding-block: var(--space-2) var(--space-5);
  }

  .narrative-body {
    max-width: var(--container-text);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .narrative-body :global(p) {
    margin-block-end: var(--space-2);
  }

  .case-gallery {
    padding-block-end: var(--space-5);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .gallery-grid :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .case-quote {
    padding-block-end: var(--space-5);
  }

  .case-quote blockquote {
    margin: 0;
  }

  .case-quote blockquote p {
    font-size: var(--text-lg);
    line-height: 1.5;
    max-width: 44ch;
    border-inline-start: 2px solid var(--color-accent);
    padding-inline-start: var(--space-3);
  }

  .case-quote figcaption {
    margin-block-start: var(--space-2);
    padding-inline-start: calc(var(--space-3) + 2px);
    font-size: var(--text-sm);
  }

  .case-back {
    padding-block-end: var(--space-5);
    font-weight: 550;
  }
</style>
