---
import Base from '../layouts/Base.astro';

// Confirmation page for the no-JS form path (astro-conventions §7).
// States what happens next and repeats the phone number. Response window
// is TBD (open item #9) and renders flagged until set.
---

<Base
  title="We have your request | Seamless Point of Care"
  description="Your request is in. Seamless Point of Care will respond and schedule next steps."
>
  <section class="section">
    <div class="container-text thanks">
      <span class="kicker">Thanks</span>
      <h1>We have it.</h1>
      <p class="lead text-secondary">
        A person will read your request and reply within
        ⟦VERIFY: response window — open item #9⟧.
      </p>
      <ol class="next-steps">
        <li><strong>We reply</strong> and ask anything we need to scope it.</li>
        <li><strong>We survey the space</strong> if the project calls for it.</li>
        <li><strong>You get one quote</strong> — hardware and installation together.</li>
      </ol>
      <p class="urgent">
        Urgent? Call <span class="num">⟦VERIFY: phone⟧</span>.
      </p>
      <p><a href="/">Back to the homepage</a></p>
    </div>
  </section>
</Base>

<style>
  .thanks h1 {
    margin-block-end: var(--space-2);
  }

  .thanks .lead {
    margin-block-end: var(--space-4);
  }

  .next-steps {
    list-style: none;
    padding: 0;
    margin-block-end: var(--space-4);
  }

  .next-steps li {
    padding-block: var(--space-2);
    border-block-start: 1px solid var(--color-rule);
    font-size: var(--text-base);
  }

  .urgent {
    font-weight: 600;
    margin-block-end: var(--space-3);
  }
</style>
